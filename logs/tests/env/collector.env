#
# Dummy environment for running an extracted collector config standalone in a
# container. The chart's collector configs reference ${...} env vars for
# credentials and node/cluster identity; the OpenTelemetry Collector resolves
# these at load time, so `validate` (and a real run) need them present.
#
# These are placeholder values for LOCAL TESTING ONLY. They are not real
# secrets. Override as needed when pointing at a real Kafka/OpenSearch.

# Cluster / node identity (set as literal env on the k8s CR; needed standalone).
cluster=test-cluster
region=test-region
KUBE_NODE_NAME=local-node
NAMESPACE=logs
MY_POD_IP=127.0.0.1

# OpenSearch basic-auth failover (basicauth/failover_* extensions are rendered
# even in Kafka mode, and the ingester consumes these too).
failover_username_a=test
failover_password_a=test
failover_username_b=test
failover_password_b=test

# Audit OpenSearch failover (only used when auditKafka is disabled; harmless here).
audit_failover_username_a=test
audit_failover_password_a=test
audit_failover_username_b=test
audit_failover_password_b=test

# Kafka SASL/SCRAM passwords.
# logs daemonset collector uses ${write_all_password}.
write_all_password=dummy-producer-password
# external + ingester collectors use prefixed names.
kafka_logs_write_all_password=dummy-producer-password
read_all_password=dummy-consumer-password
# audit Kafka producer.
kafka_audit_write_all_password=dummy-audit-producer-password
