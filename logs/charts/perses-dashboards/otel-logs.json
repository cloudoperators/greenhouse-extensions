{
  "kind": "Dashboard",
  "metadata": {
    "name": "open-telemetry",
    "createdAt": "2025-07-18T08:25:49.108936779Z",
    "updatedAt": "2025-07-23T07:15:49.477811352Z",
    "version": 713,
    "project": "default"
  },
  "spec": {
    "display": {
      "name": "OpenTelemetry Logs Dashboard"
    },
    "panels": {
      "0_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Running Pod Status"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "red",
                    "value": 0
                  },
                  {
                    "color": "green",
                    "value": 1
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "",
                    "query": "count(max by (cluster, namespace, pod) (kube_pod_status_phase{cluster=\"$cluster\", namespace=\"$namespace\", phase=\"Running\"} == 1)) or vector(0)",
                    "seriesNameFormat": "Running"
                  }
                }
              }
            }
          ]
        }
      },
      "0_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Not Shipping Collectors",
            "description": "Running logs-collector pods older than 5 minutes that exported no log records in the last 15 minutes."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "",
                    "query": "count(max by (cluster, namespace, pod) (kube_pod_status_phase{pod=~\"logs-collector-.*\", phase=\"Running\", cluster=\"$cluster\", namespace=\"$namespace\"} == 1) and on (cluster, namespace, pod) (time() - kube_pod_start_time{pod=~\"logs-collector-.*\", cluster=\"$cluster\", namespace=\"$namespace\"} > 300) unless on (cluster, namespace, pod) (sum by (cluster, namespace, pod) (rate(otelcol_exporter_sent_log_records_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[15m])) > 0)) or vector(0)",
                    "seriesNameFormat": "Not shipping"
                  }
                }
              }
            }
          ]
        }
      },
      "0_2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Failed Pod Status"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "",
                    "query": "count(max by (cluster, namespace, pod) (kube_pod_status_phase{cluster=\"$cluster\", namespace=\"$namespace\", phase=\"Failed\"} == 1)) or vector(0)",
                    "seriesNameFormat": "Failed"
                  }
                }
              }
            }
          ]
        }
      },
      "0_3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Pending Pod Status"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": 0
                  },
                  {
                    "color": "yellow",
                    "value": 1
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "",
                    "query": "count(max by (cluster, namespace, pod) (kube_pod_status_phase{cluster=\"$cluster\", namespace=\"$namespace\", phase=\"Pending\"} == 1)) or vector(0)",
                    "seriesNameFormat": "Pending"
                  }
                }
              }
            }
          ]
        }
      },
      "0_4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Running Log Collectors"
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "columnSettings": [
                {
                  "name": "timestamp",
                  "hide": true
                },
                {
                  "name": "value",
                  "hide": true
                },
                {
                  "name": "cluster"
                },
                {
                  "name": "namespace"
                },
                {
                  "name": "pod"
                },
                {
                  "name": "node"
                }
              ],
              "defaultColumnWidth": "auto",
              "density": "compact"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "",
                    "query": "max by (cluster, namespace, pod, node) (kube_pod_info{cluster=\"$cluster\", namespace=\"$namespace\", pod=~\"logs-collector-.*\"}) and on (cluster, namespace, pod) (kube_pod_status_phase{cluster=\"$cluster\", namespace=\"$namespace\", phase=\"Running\"} == 1)",
                    "seriesNameFormat": "="
                  }
                }
              }
            }
          ]
        }
      },
      "0_5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Running Operators"
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "columnSettings": [
                {
                  "name": "timestamp",
                  "hide": true
                },
                {
                  "name": "value",
                  "hide": true
                },
                {
                  "name": "cluster"
                },
                {
                  "name": "namespace"
                },
                {
                  "name": "pod"
                },
                {
                  "name": "node"
                }
              ],
              "density": "compact"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "",
                    "query": "max by (cluster, namespace, pod, node) (kube_pod_info{cluster=\"$cluster\", namespace=\"$namespace\", pod=~\".*operator-[a-zA-Z0-9]{9,10}-[a-zA-Z0-9]{5}$\"}) and on (cluster, namespace, pod) (kube_pod_status_phase{cluster=\"$cluster\", namespace=\"$namespace\", phase=\"Running\"} == 1)",
                    "seriesNameFormat": "="
                  }
                }
              }
            }
          ]
        }
      },
      "1_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Documentation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "<center>\n\n<a target=\"_blank\" \nhref=\"https://cloudoperators.github.io/greenhouse/docs/\">\nGreenhouse Documentation\n</a> \n\n<a target=\"_blank\" \nhref=\"https://cloudoperators.github.io/greenhouse/docs/reference/catalog/logs/\">\nGreenhouse Logs Plugin Documentation\n</a>\n\n<a target=\"_blank\" \nhref=\"https://github.com/cloudoperators/greenhouse-extensions\">\nGreenhouse Extensions GitHub Repository\n</a> \n\n<a target=\"_blank\" \nhref=\"https://opentelemetry.io/docs/\">\nOpenTelemetry Documentation\n</a> \n</center>"
            }
          }
        }
      },
      "2_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Log Records ${metric}",
            "description": "Accepted: count/rate of log records successfully pushed into the pipeline.\n"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.25,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum by (receiver)(${metric}(otelcol_receiver_accepted_log_records_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) ",
                    "seriesNameFormat": "Accepted: {{receiver}}"
                  }
                }
              }
            }
          ]
        }
      },
      "2_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Refused Log Records ${metric}",
            "description": "Refused: count/rate of log records that could not be pushed into the pipeline."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.25,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum by (receiver)(${metric}(otelcol_receiver_refused_log_records_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) ",
                    "seriesNameFormat": "Refused: {{receiver}}"
                  }
                }
              }
            }
          ]
        }
      },
      "3_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Batch Metrics",
            "description": "Number of times the batch was sent due to a size trigger. Number of times the batch was sent due to a timeout trigger."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.25,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 2.25,
                "pointRadius": 3.75
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum by (processor)(${metric}(otelcol_processor_batch_batch_size_trigger_send_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) ",
                    "seriesNameFormat": "Batch sent due to a size trigger: {{processor}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum  by (processor)(${metric}(otelcol_processor_batch_timeout_trigger_send_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval]))",
                    "seriesNameFormat": "Batch sent due to a timeout trigger: {{processor}}"
                  }
                }
              }
            }
          ]
        }
      },
      "4_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Log Records Exported ${metric}",
            "description": "Sent: count/rate of metric points successfully sent to destination.\nEnqueue: count/rate of metric points failed to be added to the sending queue.\nFailed: count/rate of metric points in failed attempts to send to destination."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.3,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum(${metric}(otelcol_exporter_sent_log_records_total{exporter=~\"$exporter\",cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) by (exporter)",
                    "seriesNameFormat": "Sent: {{exporter}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "",
                    "query": "sum(${metric}(otelcol_exporter_send_failed_log_records_total{exporter=~\"$exporter\",cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) by (exporter)",
                    "seriesNameFormat": "Failed: {{exporter}}"
                  }
                }
              }
            }
          ]
        }
      },
      "4_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Decrease Log Rate",
            "description": "Log records exported 2h ago divided by now, per cluster. OTelLogsDecreasing fires when this stays above 4 for 30 minutes."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.25,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "thresholds": {
                "steps": [
                  {
                    "value": 4,
                    "color": "red"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum by (k8s_cluster_name) (rate(otelcol_exporter_sent_log_records_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\", exporter!~\"debug|failover/.+\"}[1h] offset 2h)) / sum by (k8s_cluster_name) (rate(otelcol_exporter_sent_log_records_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\", exporter!~\"debug|failover/.+\"}[1h]))",
                    "seriesNameFormat": "{{k8s_cluster_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "5_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total RSS Memory",
            "description": "Total bytes of memory obtained from the OS (see 'go doc runtime.MemStats.Sys')"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.15,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "bytes"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "max(otelcol_process_memory_rss_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Max RSS"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "avg(otelcol_process_memory_rss_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Avg RSS"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "min(otelcol_process_memory_rss_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Min RSS"
                  }
                }
              }
            }
          ]
        }
      },
      "5_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total Runtime Sys Memory",
            "description": "Bytes of allocated heap objects (see 'go doc runtime.MemStats.HeapAlloc')"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.05,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "bytes"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "max(otelcol_process_runtime_total_sys_memory_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Max Go runtime sys memory"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "avg(otelcol_process_runtime_total_sys_memory_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Avg Go runtime sys memory"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "min(otelcol_process_runtime_total_sys_memory_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Min Go runtime sys memory"
                  }
                }
              }
            }
          ]
        }
      },
      "5_2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total Runtime Heap Memory",
            "description": "Total CPU user and system time in percentage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.05,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "bytes"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "max(otelcol_process_runtime_heap_alloc_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Max Go heap"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "avg(otelcol_process_runtime_heap_alloc_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Avg Go heap"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "min(otelcol_process_runtime_heap_alloc_bytes{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}) by (job)",
                    "seriesNameFormat": "Min Go heap"
                  }
                }
              }
            }
          ]
        }
      },
      "5_3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU Usage",
            "description": "Total CPU user and system time in percentage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.2
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                },
                "label": "",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "max(rate(otelcol_process_cpu_seconds_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])*100) by (job)",
                    "seriesNameFormat": "Max CPU usage"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "avg(rate(otelcol_process_cpu_seconds_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])*100) by (job)",
                    "seriesNameFormat": "Avg CPU usage"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "min(rate(otelcol_process_cpu_seconds_total{cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])*100) by (job)",
                    "seriesNameFormat": "Min CPU usage"
                  }
                }
              }
            }
          ]
        }
      },
      "6_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Pods",
            "description": "Added: Number of pod add events received.\nUpdated: Number of pod update events received.\nDeleted: Number of pod delete events received."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.15
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum(${metric}({__name__=~\"otelcol_k8s_watcher_pod_deleted_total|otelcol_otelsvc_k8s_pod_deleted_total\",cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) by (job)",
                    "seriesNameFormat": "Deleted"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum(${metric}({__name__=~\"otelcol_k8s_watcher_pod_updated_total|otelcol_otelsvc_k8s_pod_updated_total\",cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) by (job)",
                    "seriesNameFormat": "Updated"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum(${metric}({__name__=~\"otelcol_k8s_watcher_pod_added_total|otelcol_otelsvc_k8s_pod_added_total\",cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) by (job)",
                    "seriesNameFormat": "Added"
                  }
                }
              }
            }
          ]
        }
      },
      "6_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Namespaces",
            "description": "Added: Number of namespace add events received.\nUpdated: Number of namespace update events received."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "size": "medium",
                "values": [
                  "max",
                  "min"
                ]
              },
              "visual": {
                "areaOpacity": 0.15
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum(${metric}({__name__=~\"otelcol_k8s_watcher_namespace_updated_total|otelcol_otelsvc_k8s_namespace_updated_total\",cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) by (job)",
                    "seriesNameFormat": "Updated"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "minStep": "$minstep",
                    "query": "sum(${metric}({__name__=~\"otelcol_k8s_watcher_namespace_added_total|otelcol_otelsvc_k8s_namespace_added_total\",cluster=\"$cluster\",job=\"$namespace/opentelemetry-collector-logs\"}[$__rate_interval])) by (job)",
                    "seriesNameFormat": "Added"
                  }
                }
              }
            }
          ]
        }
      }
