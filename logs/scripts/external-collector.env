# Environment values for running the extracted `external` OpenTelemetryCollector
# config locally (see `make run-external-collector`).
#
# The collector config uses ${...} substitutions that Kubernetes normally
# injects via the pod `env:` block and the `otel-basic-auth` /
# `otel-syslog-audit-auth` secrets. Supply them here for a local container run.
# The values below are placeholders (matching the chart's test render); override
# as needed. Do NOT commit real credentials.

cluster=test
region=test
KUBE_NODE_NAME=local-docker

failover_username_a=test
failover_password_a=test
failover_username_b=test
failover_password_b=test

audit_failover_username_a=test
audit_failover_password_a=test
audit_failover_username_b=test
audit_failover_password_b=test
